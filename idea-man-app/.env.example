# Supabase Public Configuration
# Get these from your Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Admin / Service Role (Secret - Server Side Only)
# Used for autonomous Reddit mining ingestion and backend seeding
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Google Gemini Flash API (Ticket 03)
# Get from Google AI Studio (https://aistudio.google.com)
GEMINI_API_KEY=your-gemini-api-key-here

# Reddit API Credentials (Recommended to prevent HTTP 429 Rate Limits)
# 1. Register a 'script' app at https://www.reddit.com/prefs/apps
# 2. Set REDDIT_CLIENT_ID to the 14-char string under the app title
# 3. Set REDDIT_CLIENT_SECRET to the secret key
# If omitted or rate-limited, Idea-man automatically falls back to curated opportunity feeds with Gemini extraction
REDDIT_CLIENT_ID=your-reddit-client-id
REDDIT_CLIENT_SECRET=your-reddit-client-secret
REDDIT_USER_AGENT=web:ideaman.app:v0.1.0 (by /u/ideaman_crawler)
